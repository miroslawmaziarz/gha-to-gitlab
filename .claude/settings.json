{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/check-file",
            "timeout": 120,
            "statusMessage": "Checking the Clojure file (cljfmt, clj-kondo, Splint)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stop-check",
            "timeout": 600,
            "statusMessage": "Running bin/check (format, lint, idioms, tests)"
          }
        ]
      }
    ]
  }
}
